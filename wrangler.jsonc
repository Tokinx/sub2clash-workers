{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sub2clash-workers",
  "main": "./src/index.js",
  "compatibility_date": "2026-07-06",
  "cache": {
    "enabled": true
  },
  "exports": {
    "default": {
      "type": "worker",
      "cache": {
        "enabled": false
      }
    },
    "SubscriptionEntrypoint": {
      "type": "worker",
      "cache": {
        "enabled": true
      }
    }
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/",
      "!/index.html",
      "!/favicon.ico"
    ]
  },
  "secrets": {
    "required": [
      "APP_PASSWORD",
      "SESSION_SECRET"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "aade2b6be3d64072b81095de3a1b9310"
    }
  ]
}